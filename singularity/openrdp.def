Bootstrap: docker
From: plaquette/openrdp@sha256:3376b2efc39558f4a437853ca17882c2192536a4ddcda47df558659251459fd9

%post
    # Détection du gestionnaire de paquets (Debian/Ubuntu vs RHEL vs Alpine)
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update && apt-get install -y --no-install-recommends mafft procps wget ca-certificates
        apt-get clean && rm -rf /var/lib/apt/lists/*
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y epel-release || true
        dnf install -y mafft procps-ng wget
        dnf clean all
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache mafft procps wget
    else
        echo "Gestionnaire de paquets non identifié, installation manuelle de mafft..."
        wget https://mafft.cbrc.jp/alignment/software/mafft-7.525-linux.tgz
        tar -xzf mafft-7.525-linux.tgz -C /usr/local/
        ln -sf /usr/local/mafft-linux64/mafft.bin /usr/local/bin/mafft
        rm -f mafft-7.525-linux.tgz
    fi

    # Points de montage CHU
    mkdir -p /media /mnt /srv /data /scratch

%environment
    export PATH=/usr/local/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"

%labels
    Version 2026.3
    Tool OpenRDP + MAFFT
    Author Audrey Lapendry / Soufiane Alami

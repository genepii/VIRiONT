Bootstrap: docker
From: continuumio/miniconda3:latest
Stage: condabuild

%files
VIRiONT2_medaka.yml /VIRiONT2_medaka.yml

%post
/opt/conda/bin/conda env create -f /VIRiONT2_medaka.yml

Bootstrap: docker
From: rockylinux:8
Stage: V1

%files from condabuild
/opt/conda/envs/VIRiONT2_medaka /opt/conda/envs/VIRiONT2_medaka

%environment
export PATH=/opt/conda/envs/VIRiONT2_medaka/bin:$PATH
export JAVA_HOME=/opt/conda/envs/VIRiONT2_medaka
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

%post
dnf update -y
dnf install -y epel-release
dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb

dnf groupinstall -y "Development Tools"
dnf install -y git curl wget tar bzip2 gzip lz4 xz libcurl-devel libxml2-devel openssl-devel

# Dossiers sécurisés essentiels requis pour Nextflow
mkdir -p /media /mnt /srv /data /scratch

%help
    SUMMARY
    Conteneur de production optimisé pour le Polishing et les Variants (VIRiONT2 - Image 2).
    Contient : Medaka v2.2.2 et FreeBayes v1.3.10.

%labels
    Version 2.0.0
    Author SoufianeAlami
    Date 2026-07-20
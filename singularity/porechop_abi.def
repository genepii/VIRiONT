Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author alamiso
    Version 0.5.0
    Description "Porechop_ABI container for ONT adapter trimming"

%environment
    export PATH="/opt/conda/envs/porechop_abi/bin:$PATH"
    export LC_ALL=C

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        procps \
        git \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    mamba create -y -n porechop_abi -c conda-forge -c bioconda \
        python=3.10 \
        porechop_abi \
        && mamba clean -afy

%runscript
    exec porechop_abi "$@"

%test
    export PATH="/opt/conda/envs/porechop_abi/bin:$PATH"
    porechop_abi --version

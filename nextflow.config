/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity
========================================================================================
*/
params {
    // --- ENTRÉES & SORTIES ---
    fastq_dir            = "fastq_pass"
    input                = "fastq_pass"
    outdir               = "results"

    // --- SEUILS CLINIQUES & PARAMÈTRES ---
    min_length           = 1000
    max_length           = 5000
    min_reads            = 2
    max_reads            = 20000 // Limite optimale pour diviser la complexité All-vs-All
    mi_cutoff            = 30.0 // Seuil de co-infection clinique (30%)

    // --- SCREENING DES MUTATIONS VHB/VHD ---
    freq_min             = 0.08  // Fréquence minimale d'allèle (8%)
    window_pos           = 10    // Fenêtre d'encadrement génomique (bp)
    mutation_tables      = "${projectDir}/mutation_table"

    // --- MODÈLES POLISHING & VARIANT CALLING ---
    medaka_model         = "r1041_e82_400bps_sup_v5.2.0"
    clair3_model         = "r1041_e82_400bps_sup_v520"

    // --- IMAGES SINGULARITY ---
    sif_main             = "${projectDir}/singularity/viriont2_main.sif"
    sif_medaka           = "${projectDir}/singularity/viriont2_medaka.sif"

    // --- CACHE HOSTILE ---
    hostile_cache        = "${projectDir}/ref_hostile"
    hostile_index        = "human-t2t-hla.rs-viral-202401_ml-phage-202401"

    // --- TMP DÉDIÉ SCRATCH ---
    scratch_tmp          = "${projectDir}/tmp"
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B ${projectDir}/tmp:/tmp"
}

env {
    HOSTILE_CACHE_DIR    = "${params.hostile_cache}"
    TMPDIR               = "/tmp"
    OMP_NUM_THREADS      = "1"
    OPENBLAS_NUM_THREADS = "1"
}

process {
    container = params.sif_main
    cpus      = 8
    memory    = '32 GB'

    // --- INITIALISATION DES LOGS & METADATA ---
    withName: 'GENERATE_RUN_METADATA' {
        cpus   = 2
        memory = '8 GB'
    }

    // --- PRÉPARATION DES READS ---
    withName: 'MERGE_FASTQ' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'DEHOST_HOSTILE|TRIM_CHOPPER' {
        cpus   = 8
        memory = '32 GB'
    }

    // --- CLUSTERING HEAVY ---
    withName: 'AMPLICON_SORTER' {
        container = null
        cpus      = 28       // Allocation maximale pour accélérer le All-vs-All
        memory    = '96 GB'
    }

    // --- POLISHING & VARIANT CALLING ---
    withName: 'MEDAKA_CONSENSUS|CALL_VCF' {
        container = params.sif_medaka
        cpus      = 16       // Medaka & Clair3 bénéficient fortement de 16 cœurs
        memory    = '64 GB'
    }

    // --- ALIGNEMENT & GÉNOTYPAGE ---
    withName: 'ALIGN_BAM' {
        cpus   = 8        // minimap2 tourne très vite sur 8 cœurs
        memory = '32 GB'
    }

    withName: 'GENOTYPING' {
        cpus   = 16
        memory = '32 GB'
    }

    // --- ANALYSES GLOBALES & PHYLOGÉNIE ---
    withName: 'QC_ANALYSIS' {
        cpus   = 16
        memory = '32 GB'
    }

    withName: 'PHYLOGENY' {
        cpus   = 16       // Alignement MAFFT & arbre IQ-TREE accélérés
        memory = '64 GB'
    }

    // --- MODULE COVERAGE ---
    withName: 'COMPUTE_BAM_COVERAGE' {
        cpus   = 8
        memory = '16 GB'
    }

    withName: 'PLOT_GLOBAL_COVERAGE|COLLECT_CONSENSUS' {
        cpus   = 4
        memory = '16 GB'
    }

    // --- SCREENING MUTATIONS ---
    withName: 'SEARCH_HBV_MUTATIONS' {
        cpus   = 4
        memory = '16 GB'
    }

    withName: 'COLLECT_MUTATION_REPORTS' {
        cpus   = 2
        memory = '8 GB'
    }
}

executor {
    name      = 'local'
    queueSize = 28        // Permet de traiter jusqu'à 28 jobs légers en parallèle
}

timeline { 
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_timeline.html"
    overwrite = true
}
report { 
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_report.html"
    overwrite = true
}
trace { 
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_trace.txt"
    overwrite = true
}
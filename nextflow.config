/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity Modulaire
========================================================================================
*/
params {
    fastq_dir                = "fastq_pass"
    input                    = "fastq_pass"
    outdir                   = "results"
    run_id                   = null

    min_length               = 1000
    max_length               = 5000
    min_reads                = 20
    max_reads                = 0
    mi_cutoff                = 20.0
    consensus_min_depth      = 10
    iupac_min_freq           = 0.08
    medaka_model             = null

    min_flair_pct            = 5.0
    min_flair_size           = 150

    primers_adapters         = "${projectDir}/ref/porechop_adapters.txt"
    primers_fasta            = "${projectDir}/ref/viral_primers.fasta"
    trim_primers             = false

    tree_skeleton_n          = 2
    freq_min                 = 0.0
    window_pos               = 0
    mutation_tables          = "${projectDir}/ref"
    clair3_model             = "r1041_e82_400bps_sup_v520"
    hostile_cache            = "${projectDir}/ref_hostile"
    hostile_index            = "human-t2t-hla.rs-viral-202401_ml-phage-202401"
    scratch_tmp              = "${projectDir}/tmp"

    sif_dir                  = "/srv/scratch/chu-lyon.fr/alamiso/VIRiONT_V2/singularity"

    freq_min_filtered        = 1.0
    glims_min_minor_freq     = 8.0
    indel_min_dp_filtered    = 100
    indel_min_alt_filtered   = 5
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B ${projectDir}/tmp:/tmp"
}

env {
    HOSTILE_CACHE_DIR    = "${params.hostile_cache}"
    TMPDIR               = "/tmp"
    OMP_NUM_THREADS      = "1"
    OPENBLAS_NUM_THREADS = "1"
    KMP_DUPLICATE_LIB_OK = "TRUE"
}

process {
    cpus   = 4
    memory = '8 GB'

    withName: 'GENERATE_RUN_METADATA' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'MERGE_FASTQ' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'DEHOST_HOSTILE' {
        container = "${params.sif_dir}/hostile_2.02.sif"
        cpus      = 6
        memory    = '16 GB'
    }

    withName: 'TRIM_CHOPPER' {
        container = "${params.sif_dir}/chopper_v0.13.0.sif"
        cpus      = 4
        memory    = '16 GB'
    }

    withName: 'TRIM_PRIMERS' {
        container = "${params.sif_dir}/porechop_abi.sif"
        cpus      = 8
        memory    = '16 GB'
        time      = '2h'
    }

    withName: 'COMPETITIVE_ALIGN' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 8
        memory    = '16 GB'
    }

    withName: 'ALIGN_SUBTYPE' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 8
        memory    = '16 GB'
    }

    withName: 'GENERATE_CONSENSUS' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'COLLECT_CONSENSUS' {
        container = "${params.sif_dir}/cd_hit_v4.8.1_seqkit_v2.13.0.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'RECOMBINATION_JPHMM' {
        container = "${params.sif_dir}/jpHMM.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'COLLECT_RECOMBINATION_SUMMARIES' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'CLINICAL_FILTER' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'ALIGN_GENOTYPE_BAM' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 8
        memory    = '16 GB'
    }

    withName: 'CALL_VCF' {
        container = "${params.sif_dir}/clair3.sif"
        cpus      = 8
        memory    = '24 GB'
    }

    withName: 'RAW_PILEUP_COUNTS|RAW_INDEL_COUNTS' {
        container = "${params.sif_dir}/clair3.sif"
        cpus      = 16
        memory    = '32 GB'
    }

    withName: 'QC_MOSDEPTH' {
        container = "${params.sif_dir}/bedtools_mosdepth.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'QC_ANALYSIS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 4
        memory    = '16 GB'
    }

    withName: 'PREPARE_TREE_REFS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'PHYLOGENY' {
        container = "${params.sif_dir}/phylogeny.sif"
        cpus      = 16
        memory    = '32 GB'
    }

    withName: 'PLOT_TREE' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'COMPUTE_BAM_COVERAGE' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'PLOT_GLOBAL_COVERAGE' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'SEARCH_HBV_MUTATIONS|SEARCH_HBV_INDELS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'COLLECT_MUTATION_REPORTS|COLLECT_INDEL_REPORTS' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'FLAIR' {
        container = "${params.sif_dir}/flair_3.0.1.sif"
        cpus      = 8
        memory    = '16 GB'
    }

    withName: 'MERGE_SUMMARIES' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'FASTFINDER' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }
}

executor {
    name      = 'local'
    cpus      = 112
    memory    = '400 GB'
    queueSize = 100
}

timeline {
    enabled   = false
}

report {
    enabled   = false
}

trace {
    enabled   = false
}
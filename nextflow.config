/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity
========================================================================================
*/
params {
    // --- ENTRÉES & SORTIES ---
    fastq_dir            = "fastq_pass"
    input                = "fastq_pass"
    outdir               = "results"

    // --- SEUILS CLINIQUES & PARAMÈTRES ---
    min_length           = 1000
    max_length           = 5000
    min_reads            = 2
    max_reads            = 0
    mi_cutoff            = 30.0

    // --- SCREENING DES MUTATIONS VHB/VHD ---
    tree_skeleton_n      = 2
    freq_min             = 0.0
    window_pos           = 0
    mutation_tables      = "${projectDir}/mutation_table"
    medaka_model         = "r1041_e82_400bps_sup_v5.2.0"
    clair3_model         = "r1041_e82_400bps_sup_v520"
    sif_main             = "${projectDir}/singularity/viriont2_main.sif"
    sif_medaka           = "${projectDir}/singularity/viriont2_medaka.sif"
    hostile_cache        = "${projectDir}/ref_hostile"
    hostile_index        = "human-t2t-hla.rs-viral-202401_ml-phage-202401"
    scratch_tmp          = "${projectDir}/tmp"
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B ${projectDir}/tmp:/tmp"
}

env {
    HOSTILE_CACHE_DIR    = "${params.hostile_cache}"
    TMPDIR               = "/tmp"
    OMP_NUM_THREADS      = "1"
    OPENBLAS_NUM_THREADS = "1"
    KMP_DUPLICATE_LIB_OK = "TRUE"
}

process {
    container = params.sif_main
    cpus      = 4
    memory    = '8 GB'

    withName: 'GENERATE_RUN_METADATA' {
        cpus   = 2
        memory = '4 GB'
    }
    withName: 'MERGE_FASTQ' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'DEHOST_HOSTILE|TRIM_CHOPPER' {
        cpus   = 4
        memory = '16 GB'
    }
    withName: 'COMPETITIVE_ALIGN' {
        cpus   = 8
        memory = '16 GB'
    }
    withName: 'MEDAKA_CONSENSUS|CALL_VCF' {
        container = params.sif_medaka
        cpus      = 8
        memory    = '24 GB'
    }
    withName: 'RECOMBINATION_JPHMM' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'CLINICAL_FILTER' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'ALIGN_GENOTYPE_BAM' {
        cpus   = 6
        memory = '12 GB'
    }
    withName: 'QC_ANALYSIS' {
        cpus   = 8
        memory = '16 GB'
    }
    withName: 'PHYLOGENY' {
        cpus   = 16
        memory = '32 GB'
    }
    withName: 'COMPUTE_BAM_COVERAGE' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'PLOT_GLOBAL_COVERAGE|COLLECT_CONSENSUS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'SEARCH_HBV_MUTATIONS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'COLLECT_MUTATION_REPORTS' {
        cpus   = 2
        memory = '4 GB'
    }
}

executor {
    name      = 'local'
    cpus      = 110
    memory    = '380 GB'
    queueSize = 100
}

timeline {
    enabled   = false
}

report {
    enabled   = false
}

trace {
    enabled   = false
}
/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity
========================================================================================
*/
params {
    // --- ENTRÉES & SORTIES ---
    fastq_dir            = "fastq_pass"
    input                = "fastq_pass"
    outdir               = "results"
    // --- SEUILS CLINIQUES & PARAMÈTRES ---
    min_length           = 1000
    max_length           = 5000
    min_reads            = 2
    max_reads            = 10000 // OK de rester bas : le comptage clinique réel vient
                                  // désormais de COUNT_REAL_READS (samtools idxstats sur
                                  // le BAM aligné avec TOUS les reads), pas de ce clustering.
    mi_cutoff            = 30.0
    freq_min             = 0.08
    window_pos           = 10
    mutation_tables      = "${projectDir}/mutation_table"
    medaka_model         = "r1041_e82_400bps_sup_v5.2.0"
    clair3_model         = "r1041_e82_400bps_sup_v520"
    sif_main             = "${projectDir}/singularity/viriont2_main.sif"
    sif_medaka           = "${projectDir}/singularity/viriont2_medaka.sif"
    hostile_cache        = "${projectDir}/ref_hostile"
    hostile_index        = "human-t2t-hla.rs-viral-202401_ml-phage-202401"
    scratch_tmp          = "${projectDir}/tmp"
}
singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B ${projectDir}/tmp:/tmp"
}
env {
    HOSTILE_CACHE_DIR    = "${params.hostile_cache}"
    TMPDIR               = "/tmp"
    OMP_NUM_THREADS      = "1"
    OPENBLAS_NUM_THREADS = "1"
}
process {
    container = params.sif_main
    cpus      = 4
    memory    = '8 GB'

    withName: 'GENERATE_RUN_METADATA' {
        cpus   = 2
        memory = '4 GB'
    }
    withName: 'MERGE_FASTQ' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'DEHOST_HOSTILE|TRIM_CHOPPER' {
        cpus   = 4
        memory = '16 GB'
    }
    // Réduit pour permettre 4-5 échantillons en clustering simultané
    // (au lieu d'1 seul) — max_reads=10000 rend le clustering déjà rapide,
    // pas besoin de 32 cœurs/220GB par tâche.
    withName: 'AMPLICON_SORTER' {
        container = null
        cpus      = 12
        memory    = '48 GB'
    }
    withName: 'MEDAKA_CONSENSUS|CALL_VCF' {
        container = params.sif_medaka
        cpus      = 8
        memory    = '24 GB'
    }
    withName: 'ALIGN_BAM|COUNT_REAL_READS' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'GENOTYPING' {
        cpus   = 8
        memory = '16 GB'
    }
    withName: 'QC_ANALYSIS' {
        cpus   = 8
        memory = '16 GB'
    }
    withName: 'PHYLOGENY' {
        cpus   = 16
        memory = '32 GB'
    }
    withName: 'COMPUTE_BAM_COVERAGE' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'PLOT_GLOBAL_COVERAGE|COLLECT_CONSENSUS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'SEARCH_HBV_MUTATIONS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'COLLECT_MUTATION_REPORTS' {
        cpus   = 2
        memory = '4 GB'
    }
}
// Déclaration explicite de la capacité réelle du serveur, pour que Nextflow
// planifie correctement le parallélisme sans sous-estimer les ressources dispo.
executor {
    name      = 'local'
    cpus      = 110
    memory    = '380 GB'
    queueSize = 100
}
timeline {
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/00_SUPDATA/LOGS/execution_trace.txt"
    overwrite = true
}
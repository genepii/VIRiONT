/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity
========================================================================================
*/

params {
    // --- ENTRÉES & SORTIES ---
    fastq_dir            = "fastq_pass"
    outdir               = "results_nextflow"
    ref_dir              = "${projectDir}/ref"
    mutation_tables_dir  = "${projectDir}/mutation_table"

    // --- SEUILS CLINIQUES & PARAMÈTRES ---
    min_length           = 1000
    max_length           = 5000
    mi_cutoff            = 30.0
    min_reads            = 50
    freq_min             = 5
    window_pos           = 0

    // --- MODÈLES MEDAKA & CLAIR3 ---
    medaka_model         = "r1041_e82_400bps_sup_g615"
    clair3_model_path    = "/opt/models/r1041_e82_400bps_sup"

    // --- IMAGES SINGULARITY ---
    sif_main             = "${projectDir}/singularity/viriont2_main.sif"
    sif_medaka           = "${projectDir}/singularity/viriont2_medaka.sif"

    // --- CACHE HOSTILE ---
    hostile_cache        = "/srv/scratch/chu-lyon.fr/alamiso/VIRiONT_V2/ref_hostile"
    hostile_index        = "human-t2t-hla.rs-viral-202401_ml-phage-202401"
}

// Activation et options Singularity
singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B /tmp:/tmp"
}

// Variables d'environnement transmis à tous les conteneurs
env {
    HOSTILE_CACHE_DIR = "${params.hostile_cache}"
    TMPDIR            = "/tmp"
    OMP_NUM_THREADS   = "4"
}

// Configuration des processus et allocation des ressources CPU / Mémoire
process {
    container = params.sif_main
    cpus      = 4
    memory    = '8 GB'

    // Processus legers
    withName: 'PREPARE_REF|MERGE_FASTQ|TRIM_CHOPPER|EXTRACT_SAMPLE_QC|COMPUTE_QC_METRICS|CONCAT_CONSENSUS|GLOBAL_REPORT|PLOT_GLOBAL_COVERAGE|SEARCH_HBV_MUTATIONS' {
        cpus   = 4
        memory = '8 GB'
    }

    // Processus lourds / Parallélisés
    withName: 'DEHOST_HOSTILE|ALIGN_MAFFT|PHYLOGENY_IQTREE|VARIANT_CALLING_CLAIR3|COMPUTE_BAM_COVERAGE' {
        cpus   = 8
        memory = '32 GB'
    }

    // Configuration Amplicon_Sorter : 4 cœurs pour éviter la saturation IPC Python sous Singularity
    withName: 'AMPLICON_SORTER' {
        cpus   = 16
        memory = '64 GB'
    }

    // BLAST Genotype
    withName: 'BLAST_GENOTYPE' {
        cpus   = 8
        memory = '16 GB'
    }

    // Module Medaka (Conteneur dédié)
    withName: 'POLISH_MEDAKA' {
        container = params.sif_medaka
        cpus      = 8
        memory    = '32 GB'
    }
}

// Gestion des erreurs
executor {
    queueSize = 20
}
/*
========================================================================================
    VIRiONT_NF - Configuration Entrées/Sorties, Ressources & Singularity Modulaire
========================================================================================
*/
params {
    // --- ENTRÉES & SORTIES ---
    fastq_dir            = "fastq_pass"
    input                = "fastq_pass"
    outdir               = "results"

    // --- SEUILS CLINIQUES & PARAMÈTRES ---
    min_length           = 1000
    max_length           = 5000
    min_reads            = 2
    max_reads            = 0
    mi_cutoff            = 30.0

    // --- SCREENING DES MUTATIONS VHB/VHD ---
    tree_skeleton_n      = 2
    freq_min             = 0.0
    window_pos           = 0
    mutation_tables      = "${projectDir}/mutation_table"
    medaka_model         = "r1041_e82_400bps_sup_v5.2.0"
    clair3_model         = "r1041_e82_400bps_sup_v520"
    hostile_cache        = "${projectDir}/ref_hostile"
    hostile_index        = "human-t2t-hla.rs-viral-202401_ml-phage-202401"
    scratch_tmp          = "${projectDir}/tmp"

    // --- DOSSIER DES CONTENEURS SINGULARITY ---
    sif_dir              = "/srv/scratch/chu-lyon.fr/alamiso/VIRiONT_V2/singularity"
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B /srv:/srv -B ${projectDir}/tmp:/tmp"
}

env {
    HOSTILE_CACHE_DIR    = "${params.hostile_cache}"
    TMPDIR               = "/tmp"
    OMP_NUM_THREADS      = "1"
    OPENBLAS_NUM_THREADS = "1"
    KMP_DUPLICATE_LIB_OK = "TRUE"
}

process {
    cpus   = 4
    memory = '8 GB'

    // 00. Initialisation & Métadonnées
    withName: 'GENERATE_RUN_METADATA' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    // 01. Fusion Fastq
    withName: 'MERGE_FASTQ' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    // 02. Décontamination Hostile
    withName: 'DEHOST_HOSTILE' {
        container = "${params.sif_dir}/hostile_2.02.sif"
        cpus      = 4
        memory    = '16 GB'
    }

    // 03. Trimming Chopper
    withName: 'TRIM_CHOPPER' {
        container = "${params.sif_dir}/chopper_v0.13.0.sif"
        cpus      = 4
        memory    = '16 GB'
    }

    // 04. Alignement compétitif (minimap2 & samtools)
    withName: 'COMPETITIVE_ALIGN' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 8
        memory    = '16 GB'
    }

    // 05. Consensus Medaka
    withName: 'MEDAKA_CONSENSUS' {
        container = "${params.sif_dir}/VIRiONT2_medaka.sif"
        cpus      = 8
        memory    = '24 GB'
    }

    withName: 'COLLECT_CONSENSUS' {
        container = "${params.sif_dir}/cd_hit_v4.8.1_seqkit_v2.13.0.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    // 06. Filtrage clinique
    withName: 'CLINICAL_FILTER' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    // 06bis. Recombinaison jpHMM
    withName: 'RECOMBINATION_JPHMM' {
        container = "${params.sif_dir}/jpHMM.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'COLLECT_RECOMBINATION_SUMMARIES' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    // 07. Alignement canonique génotypé
    withName: 'ALIGN_GENOTYPE_BAM' {
        container = "${params.sif_dir}/minimap2_2.30_samtools_1.20_python_3.10.12.sif"
        cpus      = 6
        memory    = '12 GB'
    }

    // 08. Calling VCF (Clair3)
    withName: 'CALL_VCF' {
        container = "${params.sif_dir}/clair3.sif"
        cpus      = 8
        memory    = '24 GB'
    }

    // 09. Recherche des mutations VHB
    withName: 'SEARCH_HBV_MUTATIONS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '8 GB'
    }

    withName: 'COLLECT_MUTATION_REPORTS' {
        container = "${params.sif_dir}/packages_python.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    // 10. Contrôle qualité (QC)
    withName: 'QC_MOSDEPTH' {
        container = "${params.sif_dir}/bedtools_mosdepth.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'QC_ANALYSIS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 4
        memory    = '16 GB'
    }

    // 11. Phylogénie
    withName: 'PREPARE_TREE_REFS' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'PHYLOGENY' {
        container = "${params.sif_dir}/phylogeny.sif"
        cpus      = 16
        memory    = '32 GB'
    }

    // 12. Couverture et métriques
    withName: 'COMPUTE_BAM_COVERAGE' {
        container = "${params.sif_dir}/bedtools_mosdepth.sif"
        cpus      = 4
        memory    = '8 GB'
    }

    withName: 'PLOT_GLOBAL_COVERAGE' {
        container = "${params.sif_dir}/r_analysis.sif"
        cpus      = 2
        memory    = '8 GB'
    }
}

executor {
    name      = 'local'
    cpus      = 110
    memory    = '380 GB'
    queueSize = 100
}

timeline {
    enabled   = false
}

report {
    enabled   = false
}

trace {
    enabled   = false
}